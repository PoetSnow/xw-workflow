# 复制为 .env.apps 后修改（不要提交 .env.apps）
# cp .env.apps.example .env.apps

ASPNETCORE_ENVIRONMENT=Production
HOST_API_PORT=8080
AGENT_PORT=5002
CONSOLE_PORT=3000

# ---------- 中间件：你已有 Docker 容器，端口已映射到宿主机时用下面（推荐先这样）----------
# 容器内通过 host.docker.internal 访问宿主机上的 3306/6379/5672

MYSQL_CONNECTION=Server=host.docker.internal;Port=3309;database=nx_devices_erp;uid=root;pwd=C4W^Z_sk;connection timeout=30;
SYSLOG_MYSQL_CONNECTION=Server=host.docker.internal;Port=3309;database=nx_devices_erp_log;uid=root;pwd=C4W^Z_sk;connection timeout=30;
MYSQL_SERVER_VERSION=5.7.44

# Redis：用你已有的
REDIS_CONNECTION=host.docker.internal:6379,password=VQdZFq0aw5j6if7I,defaultDatabase=0,ssl=false,connectTimeout=4000,allowAdmin=true

# RabbitMQ：用 deploy/start-infra.ps1 新起的容器（默认账号见 .env.infra）
RABBITMQ_HOST=host.docker.internal
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USER=xw
RABBITMQ_PASSWORD=ChangeMe_Demo_Rabbit

# ---------- Agent：LLM（你已有）----------
AGENT_LLM_ENDPOINT=http://host.docker.internal:8066
AGENT_LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
AGENT_LLM_API_KEY=
AGENT_LLM_CHAT_PATH=/v1/chat/completions
AGENT_LLM_PROVIDER=openai
AGENT_LLM_PROFILE=local

# 知识库：Postgres 在本机；Embedding 不要指局域网 8099（公网服务器连不上）
# 对话 LLM 仍用上面的 8066；Embedding 单独走线上 OpenAI 兼容接口（不占本机第二块 GPU）
AGENT_KNOWLEDGE_ENABLED=true
AGENT_PG_CONNECTION=Host=host.docker.internal;Port=5432;Database=xw_agent;Username=postgres;Password=ChangeMe_Demo_Pg

# 示例：硅基流动（OpenAI 兼容，有 BAAI/bge-m3，维数 1024，与 docs/sql/xw_agent.postgresql.sql 一致）
# 注册拿 Key：https://siliconflow.cn  → 把下面 Endpoint/ApiKey 换成你的
AGENT_EMBEDDING_ENABLED=true
AGENT_EMBEDDING_ENDPOINT=https://api.siliconflow.cn/v1
AGENT_EMBEDDING_API_KEY=sk-your-key
AGENT_EMBEDDING_MODEL=BAAI/bge-m3
AGENT_EMBEDDING_DIMENSIONS=1024
AGENT_EMBEDDING_PATH=/embeddings

AGENT_ENABLE_STUB=false

# 演示先放开 Agent 能力权限（后续再收）；Host 业务仍靠登录 Token
AGENT_POLICY_BYPASS=true
