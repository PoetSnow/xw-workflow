# 复制为 .env 后按测试机修改（.env 不要提交）

ASPNETCORE_ENVIRONMENT=Production
HOST_API_PORT=8080

# CD 服务器用 deploy/docker-compose.host.yml 时填写（本地 compose 可忽略）
# HOST_API_IMAGE=ghcr.io/your-org/xw-host-api:latest

# 容器内访问宿主机上的 MySQL/Redis/RabbitMQ 时，主机名用 host.docker.internal
MYSQL_CONNECTION=Server=host.docker.internal;Port=3306;database=nx_devices_erp;uid=root;pwd=YOUR_PASSWORD;connection timeout=30;
SYSLOG_MYSQL_CONNECTION=Server=host.docker.internal;Port=3306;database=nx_devices_erp_log;uid=root;pwd=YOUR_PASSWORD;connection timeout=30;
MYSQL_SERVER_VERSION=5.7.44

REDIS_CONNECTION=host.docker.internal:6379,password=YOUR_REDIS_PASSWORD,defaultDatabase=0,ssl=false,connectTimeout=4000,allowAdmin=true

RABBITMQ_HOST=host.docker.internal
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
