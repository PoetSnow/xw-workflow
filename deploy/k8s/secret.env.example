# 复制为 secret.env（勿提交），键名需与 deployment.yaml 中 secretKeyRef 一致
# 创建 Secret：
#   kubectl create namespace xw
#   kubectl create secret generic xw-host-api-secret -n xw --from-env-file=deploy/k8s/secret.env

ASPNETCORE_ENVIRONMENT=Production

# 中间件在宿主机 Docker Compose 上时，主机名用 host.docker.internal（需 deployment hostAliases）
Mysql__ConnectionString=Server=host.docker.internal;Port=3306;database=nx_devices_erp;uid=root;pwd=YOUR_PASSWORD;connection timeout=30;
SysLogDb__ConnectionString=Server=host.docker.internal;Port=3306;database=nx_devices_erp_log;uid=root;pwd=YOUR_PASSWORD;connection timeout=30;
Mysql__ServerVersion=5.7.44

Redis__Dbconfig__ConnectionString=host.docker.internal:6379,password=YOUR_REDIS_PASSWORD,defaultDatabase=0,ssl=false,connectTimeout=4000,allowAdmin=true

RabbitMq__HostName=host.docker.internal
RabbitMq__Port=5672
RabbitMq__VirtualHost=/
RabbitMq__UserName=guest
RabbitMq__Password=guest
