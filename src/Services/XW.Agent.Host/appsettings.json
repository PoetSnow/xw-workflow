{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Telemetry": {
    "Enabled": true,
    "ConsoleExporter": true,
    "OtlpEndpoint": ""
  },
  "Agent": {
    "Channel": "web",
    "EnableStubTools": true,
    "HostApi": {
      "BaseUrl": "http://localhost:5295",
      "AccessToken": "",
      "TimeoutSeconds": 30
    },
    "Planner": {
      "Enabled": true,
      "MaxSteps": 6,
      "Retrieval": {
        "Enabled": true,
        "TopK": 8,
        "ExpandRelated": true,
        "MinScore": 0
      }
    },
    "Catalog": {
      "Mode": "layered"
    },
    "Skills": {
      "Enabled": true,
      "RootPath": "skills",
      "ReloadOnChange": true
    },
    "Knowledge": {
      "Enabled": true,
      "Provider": "vector",
      "AutoRetrieve": true,
      "TopK": 4,
      "MinSimilarity": 0.25,
      "ChunkSize": 700,
      "ChunkOverlap": 80,
      "SeedRelativePath": "knowledge/seed",
      "UploadRelativePath": "knowledge/uploads",
      "MaxUploadBytes": 20971520,
      "UploadDeadlineSeconds": 280,
      "ConnectionString": "Host=127.0.0.1;Port=5432;Database=xw_agent;Username=postgres;Password=123456",
      "Embedding": {
        "Enabled": true,
        "Endpoint": "http://192.168.1.150:8099",
        "ApiKey": "",
        "ModelName": "BAAI/bge-m3",
        "Dimensions": 1024,
        "EmbeddingsPath": "/v1/embeddings",
        "TimeoutSeconds": 60
      }
    },
    "Runtime": {
      "ChatDeadlineSeconds": 110
    },
    "Jobs": {
      "CapEnabled": false
    },
    "Policy": {
      "Bypass": false,
      "DenyByDefault": true,
      "RolePermissions": {
        "warehouse": [ "agent.inventory.read", "agent.alert.read", "agent.knowledge.read" ],
        "cs": [ "agent.order.read", "agent.knowledge.read" ],
        "purchaser": [ "agent.purchase.read", "agent.purchase.write", "agent.inventory.read", "agent.knowledge.read" ],
        "admin": [ "*" ],
        "administrator": [ "*" ],
        "manager": [ "*" ]
      },
      "PermissionAliases": {
        "inventoryBalance": [ "agent.inventory.read" ],
        "inventorySerial": [ "agent.inventory.read" ],
        "stockInbound": [ "agent.inventory.read" ],
        "stockOutbound": [ "agent.inventory.read" ],
        "purchaseOrder": [ "agent.purchase.read", "agent.purchase.write" ],
        "order": [ "agent.order.read" ],
        "/supplyChain": [ "agent.inventory.read", "agent.alert.read", "agent.purchase.read" ]
      }
    },
    "AuthProfiles": [
      { "Code": "none", "Type": "none" },
      { "Code": "host-bearer", "Type": "bearer", "Token": "" },
      { "Code": "forward-caller", "Type": "forward_caller" }
    ],
    "Llm": {
      "Enabled": true,
      "ActiveProfile": "local",
      "ConfidenceThreshold": 0.6,
      "FallbackToRules": true,
      "PersistRuntimeOverrides": true,
      "Profiles": [
        {
          "Code": "local",
          "Name": "内网 Qwen (61.144.189.71:8066 Chat)",
          "ProviderCode": "vllm",
          "Endpoint": "http://61.144.189.71:8066",
          "ModelName": "Qwen/Qwen2.5-3B-Instruct",
          "ApiKey": "",
          "Temperature": 0.1,
          "UseJsonResponseFormat": false,
          "ToolProtocol": "native_tools",
          "ChatCompletionsPath": "/v1/chat/completions"
        },
        {
          "Code": "cloud",
          "Name": "云端 OpenAI 兼容",
          "ProviderCode": "openai",
          "Endpoint": "https://api.openai.com",
          "ModelName": "gpt-4o-mini",
          "ApiKey": "",
          "Temperature": 0.1,
          "UseJsonResponseFormat": true,
          "ToolProtocol": "native_tools"
        }
      ]
    }
  }
}
