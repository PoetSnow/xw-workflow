{
  "Code": "purchase.order.create.material",
  "Name": "创建物料采购单(草稿)",
  "Domain": "purchase",
  "WhenToUse": "用户确认要创建物料采购单；参数齐全且已选定供应商。",
  "Tags": [ "采购单", "物料", "写入" ],
  "Aliases": [ "建物料采购单", "采购物料" ],
  "RelatedCodes": [ "materials.search", "suppliers.search", "purchase.price.compare" ],
  "Risk": "write",
  "Description": "创建草稿物料采购单（单行）。",
  "Permissions": [ "agent.purchase.write" ],
  "IntentCode": "purchase.order.create.material",
  "Enabled": true,
  "ConfirmRequired": true,
  "OutputHints": [
    { "Name": "orderNo", "Description": "采购单号" },
    { "Name": "id", "Description": "采购单主键" }
  ],
  "Parameters": [
    { "Name": "supplierId", "Required": true, "Type": "string" },
    { "Name": "materialId", "Required": true, "Type": "string" },
    { "Name": "qty", "Required": true, "Type": "string" },
    { "Name": "uomId", "Required": true, "Type": "string" },
    { "Name": "unitPrice", "Required": true, "Type": "string" },
    { "Name": "remark", "Required": false, "Type": "string" }
  ],
  "Http": {
    "Adapter": "host",
    "AuthProfile": "forward-caller",
    "Method": "POST",
    "Path": "/api/console/supply-chain/PurchaseOrders/materials",
    "BodyTemplate": "{\"idempotencyKey\":\"{{idempotencyKey}}\",\"supplierId\":{{supplierId}},\"remark\":\"{{remark}}\",\"lines\":[{\"idempotencyKey\":\"{{lineIdempotencyKey}}\",\"materialId\":{{materialId}},\"qty\":{{qty}},\"uomId\":{{uomId}},\"unitPrice\":{{unitPrice}}}]}",
    "TimeoutSeconds": 30,
    "MaxRetries": 0,
    "FallbackToStub": false
  }
}
