<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/internal-nlog.txt">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <variable name="logLayout" value="${longdate}|${level:uppercase=true}|${logger:shortName=true}|${message}${onexception:inner=${newline}${exception:format=tostring}}" />

  <targets>
    <target xsi:type="Console" name="console" layout="${logLayout}" />
    <target xsi:type="File" name="file"
            fileName="${basedir}/logs/${shortdate}.log"
            layout="${logLayout}"
            concurrentWrites="true"
            keepFileOpen="false" />
  </targets>

  <rules>
    <logger name="Microsoft.AspNetCore.Hosting.Diagnostics" minlevel="Information" writeTo="console,file" final="true" />
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Information" writeTo="console,file" final="true" />
    <logger name="Microsoft.*" maxlevel="Information" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Information" final="true" />
    <logger name="*" minlevel="Debug" writeTo="console,file" />
  </rules>
</nlog>
